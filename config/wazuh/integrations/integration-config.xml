<!--
  IoT-Access-Sentinel Integration Configuration
  Add this to Wazuh Manager's ossec.conf
-->

<integration>
  <name>iot-sentinel</name>
  <hook_url>http://host.docker.internal:8000/access-control</hook_url>
  <level>5</level>
  <group>iot,access_control</group>
  <alert_format>json</alert_format>
</integration>
