# Environment Configuration for IoT-Access-Sentinel
# SECURITY: Copy this file to .env and NEVER commit .env to version control

# === Wazuh Manager Configuration ===
WAZUH_MANAGER_URL=https://wazuh-manager:55000
WAZUH_USERNAME=wazuh-wui
WAZUH_PASSWORD=your-wazuh-password-here
WAZUH_VERIFY_SSL=false

# === Wazuh Indexer Configuration (Docker Deployment) ===
WAZUH_INDEXER_USERNAME=admin
WAZUH_INDEXER_PASSWORD=ChangeMe-SecurePassword123!

# === Wazuh Dashboard Configuration (Docker Deployment) ===
WAZUH_DASHBOARD_USERNAME=kibanaserver
WAZUH_DASHBOARD_PASSWORD=ChangeMe-DashboardPassword456!

# === LLM Provider Configuration ===
# Options: openai, gemini, ollama
LLM_PROVIDER=openai
LLM_MODEL=llama-3.3-70b-versatile

# OpenAI-Compatible API (Groq/OpenAI)
OPENAI_API_KEY=your-api-key-here
OPENAI_BASE_URL=https://api.groq.com/openai/v1

# Google Gemini Configuration (alternative)
# GEMINI_API_KEY=your-gemini-api-key-here

# Ollama Configuration (local deployment)
# OLLAMA_BASE_URL=http://localhost:11434

# === Access Control Settings ===
MIN_SEVERITY=5
POLICY_FILE_PATH=config/access_policies.yaml

# === Enforcement Settings ===
# Set to false for dry-run mode (decisions logged but not enforced)
ENFORCEMENT_ENABLED=true
MIN_DECISION_CONFIDENCE=0.75

# === API Configuration ===
HOST=0.0.0.0
PORT=8000
LOG_LEVEL=info

# === Timeouts (seconds) ===
WAZUH_API_TIMEOUT=30
LLM_API_TIMEOUT=60
ENFORCEMENT_TIMEOUT=10

# === Security Secrets (REQUIRED) ===
JWT_SECRET_KEY=change-me-to-a-random-secret
WEBHOOK_API_KEY=change-me-to-a-random-key
